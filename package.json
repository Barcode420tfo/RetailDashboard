    "cors": "^2.8.6",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.45.0",
    "mongoose": "^9.0.0",
    "multer": "^2.3.0",
    "papaparse": "^5.7.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.88.0",
    "react-router-dom": "^7.18.3",
    "recharts": "^3.10.1",
