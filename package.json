{
  "name": "sales-operations-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test": "node --test",
    "db:indexes": "node --env-file=.env server/scripts/create-indexes.js",
    "dev": "concurrently -k -n api,web \"npm:dev:server\" \"npm:dev:client\"",
